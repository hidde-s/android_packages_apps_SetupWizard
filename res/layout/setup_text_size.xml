<com.google.android.setupdesign.GlifLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/SudContentFrame">

        <FrameLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <!-- Normal text size button -->
                    <Button
                        android:id="@+id/text_size_normal_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_size_normal"
                        android:textSize="14sp"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="?android:attr/selectableItemBackground" />

                    <!-- Bigger text size button -->
                    <Button
                        android:id="@+id/text_size_bigger_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_size_bigger"
                        android:textSize="16sp"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="?android:attr/selectableItemBackground" />

                    <!-- Biggest text size button -->
                    <Button
                        android:id="@+id/text_size_biggest_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_size_biggest"
                        android:textSize="18sp"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground" />

                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <org.lineageos.setupwizard.NavigationLayout
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
